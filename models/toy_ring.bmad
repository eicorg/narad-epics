! Generated by generate_lattice.py. See README.md for provenance and assumptions.
! 96 identical 40 m FODO cells; 8 cells/section, 2 sections/arc, 6 arcs.
! No dispersion suppressors, insertions, RF, or dedicated straight sections.
parameter[geometry] = closed
parameter[particle] = electron
parameter[p0c] = 18e9
beginning[beta_a] = 15
beginning[beta_b] = 15
! Positive curvature closes the clockwise ESR-like ring in Bmad floor coordinates.
ring_curvature = twopi / (192 * 6.6213999999999995)
! Illustrative linear calibration, Tesla/A (replace with measured calibration).
